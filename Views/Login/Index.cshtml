@{
    ViewData["Title"] = "Login";
}

<div class="login-container">
    <h2 class="login-heading">Login</h2>
    @if (ViewBag.Error != null)
    {
        <div class="login-error">@ViewBag.Error</div>
    }
    <form asp-controller="Login" asp-action="Login" method="post">
        <label for="email" class="login-label">Email</label>
        <input type="email" id="email" name="email" class="login-input" placeholder="Enter your email" autocomplete="email" required />
        <label for="password" class="login-label">Password</label>
        <input type="password" id="password" name="password" class="login-input" placeholder="Enter your password" autocomplete="current-password" required />
        <button type="submit" class="login-button">Login</button>
    </form>
</div>

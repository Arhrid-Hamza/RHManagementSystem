@model RHManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";

    // Prepare SelectList for Role
    var roles = new List<SelectListItem>
    {
        new SelectListItem { Value = "employee", Text = "Employee", Selected = Model.Role == "employee" },
        new SelectListItem { Value = "admin", Text = "Admin", Selected = Model.Role == "admin" }
    };

    // Prepare SelectList for Departments
    var departments = (ViewData["Departments"] as List<RHManagementSystem.Models.Department>)
        .Select(d => new SelectListItem
        {
            Value = d.DepartmentId.ToString(),
            Text = d.Name,
            Selected = d.DepartmentId == Model.DepartmentId
        }).ToList();
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-semibold mb-0">Edit Employee</h2>
        <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
    </div>

    <!-- Form Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Employee Details</h5>
            <form asp-action="Edit" class="needs-validation" novalidate>
                <input type="hidden" asp-for="EmployeeId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Name -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Mail -->
                <div class="mb-3">
                    <label asp-for="Mail" class="form-label"></label>
                    <input asp-for="Mail" class="form-control" />
                    <span asp-validation-for="Mail" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <!-- Role -->
                <div class="mb-3">
                    <label asp-for="Role" class="form-label"></label>
                    <select asp-for="Role" class="form-select" asp-items="roles"></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <!-- Department -->
                <div class="mb-3">
                    <label asp-for="DepartmentId" class="form-label"></label>
                    <select asp-for="DepartmentId" class="form-select" asp-items="departments"></select>
                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

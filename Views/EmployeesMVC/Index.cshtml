@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Employees</h1>
        <a asp-action="Create" class="btn btn-primary">+Create New</a>
    </div>

    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark" style="color: black;">
            <tr>
                <th>EmployeeId</th>
                <th>Name</th>
                <th>Mail</th>
                <th>Role</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EmployeeId</td>
                    <td>@item.Name</td>
                    <td>@item.Mail</td>
                    <td>@item.Role</td>
                    <td>@item.DepartmentName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn-edit btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.EmployeeId" class="btn-show btn btn-sm btn-info text-white">Details</a>

                        <form asp-action="Delete" asp-route-id="@item.EmployeeId" method="post" class="d-inline delete-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-delete btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Affichage du message success après Create/Edit/Delete
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Success!',
                    text: '@TempData["SuccessMessage"]',
                    icon: 'success',
                    confirmButtonText: 'OK',
                    position: 'top'
                });
                </text>
            }

            // Confirmation de suppression SweetAlert
            const deleteForms = document.querySelectorAll('.delete-form');
            deleteForms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'No, cancel!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire(
                                'Cancelled',
                                'The employee is safe :)',
                                'error'
                            );
                        }
                    });
                });
            });
        });
    </script>
}

@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Employees";
}

<div class="page-container">
    <div class="page-header">
        <h1>Employees</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>
                    EmployeeId
                </th>
                <th>
                    Name
                </th>
                <th>
                    Mail
                </th>
                <th>
                    Role
                </th>
                <th>
                    Department
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.EmployeeId
                    </td>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        @item.Mail
                    </td>
                    <td>
                        @item.Role
                    </td>
                    <td>
                        @item.DepartmentName
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn-edit">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.EmployeeId" class="btn-show">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.EmployeeId" class="btn-delete">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteButtons = document.querySelectorAll('.btn-delete');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const url = this.getAttribute('href');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'No, cancel!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = url;
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire(
                                'Cancelled',
                                'The employee is safe :)',
                                'error'
                            );
                        }
                    });
                });
            });
        });
    </script>
}

@model RHManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-semibold mb-0">Employee Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn-edit btn btn-outline-primary me-2">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h5 class="card-title text-primary mb-3">Employee Information</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Employee ID</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.EmployeeId)</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Name)</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Mail)</dd>

                <dt class="col-sm-3">Role</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Role)</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Html.DisplayFor(model => model.Department)</dd>
            </dl>
        </div>
    </div>
</div>

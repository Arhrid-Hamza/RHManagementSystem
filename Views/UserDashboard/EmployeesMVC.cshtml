@model IEnumerable<RHManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h2>Employees</h2>
<p>All employee records are displayed here.</p>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.EmployeeId</td>
                <td>@emp.Name</td>
                <td>@emp.Role</td>
            </tr>
        }
    </tbody>
</table>

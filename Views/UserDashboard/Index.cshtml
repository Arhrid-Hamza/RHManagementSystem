﻿@{
    ViewData["Title"] = "User Dashboard";
    var userName = Context.Session.GetString("UserName");
    var userId = Context.Session.GetString("UserId");
}

<div class="page-container">
    <!-- Header -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <h1>User Dashboard</h1>
        <a href="/UserDashboard/Logout" class="btn btn-danger btn-sm">Logout</a>
    </div>

    <h4 class="mb-4">Welcome, <strong>@userName</strong></h4>

    <table class="table table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>Feature</th>
                <th>Description</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Profile</td>
                <td>Edit your profile information</td>
                <td>
                    <a href="/UsersMVC/Edit/@userId" class="btn btn-primary btn-sm">Edit Profile</a>
                </td>
            </tr>
            <tr>
                <td>Employees</td>
                <td>View employee records</td>
                <td>
                    <a href="/UserDashboard/EmployeesMVC" class="btn btn-secondary btn-sm">View Employees</a>
                </td>
            </tr>
            <tr>
                <td>Departments</td>
                <td>View department information</td>
                <td>
                    <a href="/UserDashboard/DepartmentsMVC" class="btn btn-secondary btn-sm">View Departments</a>
                </td>
            </tr>
            <tr>
                <td>Projects</td>
                <td>View project details</td>
                <td>
                    <a href="/UserDashboard/ProjectsMVC" class="btn btn-secondary btn-sm">View Projects</a>
                </td>
            </tr>
            <tr>
                <td>Reports</td>
                <td>View report summaries</td>
                <td>
                    <a href="/UserDashboard/ReportsMVC" class="btn btn-secondary btn-sm">View Reports</a>
                </td>
            </tr>
        </tbody>
    </table>
</div>

@model IEnumerable<RHManagementSystem.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="page-container">
    <div class="page-header">
        <h1>Projects</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>
                    ProjectId
                </th>
                <th>
                    Name
                </th>
                <th>
                    Description
                </th>
                <th>
                    Department Responsible
                </th>
                <th>
                    Employee Responsible
                </th>
                <th>
                    Start Date
                </th>
                <th>
                    End Date
                </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.ProjectId
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.DepartmentResponsibleNavigation?.Name 
                </td>
                <td>
                    @item.EmployeeResponsibleNavigation?.Name 
                </td>
                <td>
                    @item.StartDate?.ToShortDateString() 
                </td>
                <td>
                    @item.EndDate?.ToShortDateString()
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProjectId" class="btn-edit">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.ProjectId" class="btn-delete">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Success!',
                    text: '@TempData["SuccessMessage"]',
                    icon: 'success',
                    confirmButtonText: 'OK',
                    position: 'top'
                });
                </text>
            }

            const deleteButtons = document.querySelectorAll('.btn-delete');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const url = this.getAttribute('href');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'No, cancel!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = url;
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire(
                                'Cancelled',
                                'The project is safe :)',
                                'error'
                            );
                        }
                    });
                });
            });
        });
    </script>
}

@model RHManagementSystem.Models.Project

@{
    ViewData["Title"] = "Create Project";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Create Project</h2>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>

    <div class="card shadow-sm border-0 p-3">
        <form asp-action="Create">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label text-dark"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label text-dark"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DepartmentResponsible" class="form-label text-dark"></label>
                <select asp-for="DepartmentResponsible" asp-items="ViewBag.DepartmentResponsible" class="form-select">
                    <option value="">Select Department</option>
                </select>
                <span asp-validation-for="DepartmentResponsible" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmployeeResponsible" class="form-label text-dark"></label>
                <select asp-for="EmployeeResponsible" asp-items="ViewBag.EmployeeResponsible" class="form-select">
                    <option value="">Select Employee</option>
                </select>
                <span asp-validation-for="EmployeeResponsible" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label text-dark"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label text-dark"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

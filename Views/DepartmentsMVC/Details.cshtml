        <h1>Details</h1>
        <a asp-action="Edit" asp-route-id="@Model.DepartmentId">Edit</a>
        <a asp-action="Index">Back to List</a>
    </div>

    <div>
        <h4>Department</h4>
        <hr />
        <dl class="row">

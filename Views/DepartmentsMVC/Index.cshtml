@model IEnumerable<RHManagementSystem.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="page-container">
    <div class="page-header">
        <h1>Departments</h1>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Department ID</th>
                <th>Name</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.DepartmentId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DepartmentId" class="btn-edit">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.DepartmentId" class="btn-show">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.DepartmentId" class="btn-delete">Delete</a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                Swal.fire({
                    title: 'Success!',
                    text: '@TempData["SuccessMessage"]',
                    icon: 'success',
                    confirmButtonText: 'OK'
                });
                </text>
            }

            const deleteButtons = document.querySelectorAll('.btn-delete');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const url = this.getAttribute('href');
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "You won't be able to revert this!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'No, cancel!'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = url;
                        } else if (result.dismiss === Swal.DismissReason.cancel) {
                            Swal.fire(
                                'Cancelled',
                                'The department is safe :)',
                                'error'
                            );
                        }
                    });
                });
            });
        });
    </script>
}

﻿@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-semibold mb-0">Admin Dashboard</h2>
        <a href="/AdminDashboard/Logout" class="btn btn-outline-danger btn-sm">
            Logout
        </a>
    </div>

    <!-- Welcome -->
    <div class="alert alert-light border mb-4">
        <strong>Welcome,</strong> @Context.Session.GetString("UserName")
    </div>

    <!-- Chart -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-white fw-semibold">
            Management Overview
        </div>
        <div class="card-body">
            <canvas id="overviewChart" height="110"></canvas>
        </div>
    </div>

    <!-- Dashboard Cards -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4">

        <!-- Users -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="fs-1 text-primary mb-2">👥</div>
                    <h5 class="fw-semibold">Users</h5>
                    <div class="mt-auto">
                        <a href="/UsersMVC" class="btn btn-outline-primary btn-sm w-100 mb-2">
                            Manage Users
                        </a>
                        <a href="/UsersMVC/Create" class="btn btn-primary btn-sm w-100">
                            Add User
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Employees -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="fs-1 text-success mb-2">👨‍💼</div>
                    <h5 class="fw-semibold">Employees</h5>
                    <div class="mt-auto">
                        <a href="/EmployeesMVC" class="btn btn-outline-success btn-sm w-100 mb-2">
                            Manage Employees
                        </a>
                        <a href="/EmployeesMVC/Create" class="btn btn-success btn-sm w-100">
                            Add Employee
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Departments -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="fs-1 text-warning mb-2">🏢</div>
                    <h5 class="fw-semibold">Departments</h5>
                    <div class="mt-auto">
                        <a href="/DepartmentsMVC" class="btn btn-outline-warning btn-sm w-100 mb-2">
                            Manage Departments
                        </a>
                        <a href="/DepartmentsMVC/Create" class="btn btn-warning btn-sm w-100">
                            Add Department
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Projects -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="fs-1 text-info mb-2">📁</div>
                    <h5 class="fw-semibold">Projects</h5>
                    <div class="mt-auto">
                        <a href="/ProjectsMVC" class="btn btn-outline-info btn-sm w-100 mb-2">
                            Manage Projects
                        </a>
                        <a href="/ProjectsMVC/Create" class="btn btn-info btn-sm w-100 text-white">
                            Add Project
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reports (CENTERED) -->
        <div class="col mx-auto">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body d-flex flex-column text-center">
                    <div class="fs-1 text-secondary mb-2">📊</div>
                    <h5 class="fw-semibold">Reports</h5>
                    <div class="mt-auto">
                        <a href="/ReportsMVC" class="btn btn-outline-secondary btn-sm w-100 mb-2">
                            View Reports
                        </a>
                        <a href="/ReportsMVC/Create" class="btn btn-secondary btn-sm w-100">
                            Add Report
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const ctx = document.getElementById('overviewChart');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Employees', 'Departments'],
            datasets: [{
                data: [@ViewBag.EmployeeCount, @ViewBag.DepartmentCount],
                backgroundColor: ['#0d6efd', '#6f42c1'],
                borderRadius: 6
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true } }
        }
    });
</script>

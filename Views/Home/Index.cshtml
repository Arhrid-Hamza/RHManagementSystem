﻿@{
    ViewData["Title"] = "Home Page";
}

<div style="text-align: center; padding: 50px; background-color: #f9f9f9; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
    <h1 style="font-size: 2.5em; margin-bottom: 20px; color: #333;">Welcome to the HR Management System</h1>

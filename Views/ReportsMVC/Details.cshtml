@model RHManagementSystem.Models.Report

@{
    ViewData["Title"] = "Report Details";
}

<div class="page-container">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-semibold mb-0">Report Details</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.ReportId" class="btn btn-primary btn-sm me-2">Edit</a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">Back to List</a>
        </div>
    </div>

    <div class="card p-3">
        <dl class="row">
            <dt class="col-sm-2 text-dark">@Html.DisplayNameFor(model => model.ReportId)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.ReportId)</dd>

            <dt class="col-sm-2 text-dark">@Html.DisplayNameFor(model => model.Title)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>

            <dt class="col-sm-2 text-dark">@Html.DisplayNameFor(model => model.GeneratedBy)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.GeneratedBy)</dd>

            <dt class="col-sm-2 text-dark">@Html.DisplayNameFor(model => model.Date)</dt>
            <dd class="col-sm-10">@Model.Date.ToShortDateString()</dd>

            <dt class="col-sm-2 text-dark">@Html.DisplayNameFor(model => model.Content)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Content)</dd>
        </dl>
    </div>
</div>
